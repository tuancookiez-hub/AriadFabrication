{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariad.local/schemas/v1/interface-material-profile.schema.json",
  "title": "Ariad Interface Fixture Material Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "name",
    "status",
    "material_type",
    "selected_nozzle_temperature_c",
    "selected_bed_temperature_c",
    "fan_percent",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0-interface-fixture"},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "name": {"type": "string", "minLength": 1, "maxLength": 512},
    "status": {"const": "interface_fixture_uncalibrated"},
    "material_type": {"type": "string", "minLength": 1, "maxLength": 128},
    "selected_nozzle_temperature_c": {"type": "number", "exclusiveMinimum": 0},
    "selected_bed_temperature_c": {"type": "number", "minimum": 0},
    "fan_percent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "number", "minimum": 0, "maximum": 100},
        "maximum": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1, "maxLength": 4096}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariad.local/schemas/v1/execution-request.schema.json",
  "title": "Ariad no-hardware execution request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "idempotency_key",
    "target",
    "benchmark_id",
    "requested_by",
    "hardware_actions"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "target": {
      "enum": ["golden_part_r2", "golden_part_r4"]
    },
    "benchmark_id": {
      "const": "opengrow_stake_electronics_clamp_v1"
    },
    "requested_by": {"const": "local_user"},
    "hardware_actions": {"const": false}
  }
}

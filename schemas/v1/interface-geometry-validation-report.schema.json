{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariad.local/schemas/v1/interface-geometry-validation-report.schema.json",
  "title": "Ariad Interface Fixture Geometry Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "passed",
    "evidence_level",
    "claim_boundary",
    "measurements",
    "checks",
    "warnings",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0-interface-fixture"},
    "status": {"enum": ["passed", "failed"]},
    "passed": {"type": "boolean"},
    "evidence_level": {"enum": ["R2", null]},
    "claim_boundary": {"type": "string", "minLength": 1, "maxLength": 4096},
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design_envelope", "solid_body_count", "stake_bore_diameter"],
      "properties": {
        "design_envelope": {"$ref": "#/$defs/xyz"},
        "solid_body_count": {"type": "integer", "minimum": 0},
        "stake_bore_diameter": {"type": "number", "minimum": 0}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "description",
          "actual",
          "expected",
          "passed",
          "tolerance_mm"
        ],
        "properties": {
          "check_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "description": {"type": "string", "minLength": 1, "maxLength": 2048},
          "actual": {},
          "expected": {},
          "passed": {"type": "boolean"},
          "tolerance_mm": {"type": ["number", "null"], "minimum": 0}
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    },
    "errors": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"passed": {"const": true}}, "required": ["passed"]},
      "then": {
        "properties": {
          "status": {"const": "passed"},
          "evidence_level": {"const": "R2"},
          "errors": {"maxItems": 0},
          "checks": {
            "items": {
              "properties": {"passed": {"const": true}},
              "required": ["passed"]
            }
          }
        }
      },
      "else": {
        "properties": {
          "status": {"const": "failed"},
          "evidence_level": {"type": "null"},
          "errors": {"minItems": 1},
          "checks": {
            "contains": {
              "properties": {"passed": {"const": false}},
              "required": ["passed"]
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "xyz": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "z": {"type": "number", "minimum": 0}
      }
    }
  }
}
